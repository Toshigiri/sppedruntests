# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — vision model used for the "which question/section is on screen"
# check. Defaults to a fast/cheap model since this runs every 20-30s.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Only needed if this is reachable off your own machine (e.g. deployed to a
# host with a public URL). Leave both blank for local-only use — auth is
# skipped entirely when APP_PASSWORD is unset. Set a real password before
# deploying publicly, or anyone with the URL can use your API key.
APP_USERNAME=exam
APP_PASSWORD=

# Optional — where run history (runs.json) is stored. Defaults to ./data.
# Point this at a mounted persistent disk when deploying somewhere with
# an ephemeral filesystem, or history resets on every redeploy/restart.
DATA_DIR=
