# AI section detection runs against a local LM Studio server (Developer tab
# -> Start Server), not a cloud API — no key needed, nothing leaves your
# machine. Only works when this app and LM Studio run on the same machine;
# a deployed copy (e.g. on Render) can't reach your PC, so this feature is
# local-only. Leave both blank to use LM Studio's defaults.
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=gemma-3-4b-it

# Only needed if this is reachable off your own machine (e.g. deployed to a
# host with a public URL). Leave both blank for local-only use — auth is
# skipped entirely when APP_PASSWORD is unset. Set a real password before
# deploying publicly, or anyone with the URL can use the app and see your
# run history.
APP_USERNAME=exam
APP_PASSWORD=

# Optional — where run history (runs.json) is stored. Defaults to ./data.
# Point this at a mounted persistent disk when deploying somewhere with
# an ephemeral filesystem, or history resets on every redeploy/restart.
DATA_DIR=
